manifest {
	name = 'swgs-relafier'
	description = 'nf pipeline to get relative copy number profiles from sWGS'
	version = '8'
}

executor {
	name = 'slurm'
	queuesize = 50
	submitRateLimit = '10 sec'
	perCpuMemAllocation = true
}

conda {
	enabled = true
	cacheDir = "/data/scratch/DMP/UCEC/EVOLIMMU/hcrook/.conda/envs"
	useMamba = true
}

singularity {
	enabled = true
}

plugins {
  id 'nf-schema@2.4.1'
}

params.outdir = 'results'
params.input = null
params.fasta = null
params.binsize = 30
params.adap = null
params.sexChrIncl = false
params.bedfile = null
params.quant_labels = ['10','20','30']

process {
	withName: MOSDEPTH {
		publishDir = [
			path: { "${params.outdir}/mosdepth" },
			mode: 'copy',
			saveAs: { filename -> filename }
		]
	}
}